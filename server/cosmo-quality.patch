+def get_quality_format(quality: str | None, info: dict) -> str:
+    selector = resolve_video_quality_format(quality)
+    # A vertical 720p video is 720x1280: limit its width, not its height.
+    try:
+        width, height = float(info.get("width") or 0), float(info.get("height") or 0)
+    except (TypeError, ValueError):
+        width = height = 0
+    if 0 < width < height:
+        selector = selector.replace("height<=", "width<=")
+    return selector
 
 
